FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 47;     // 15 % intensity at ~48 m/s (31 axial + 37 swirl)

boundaryField
{
    inlet
    {
        type            timeVaryingMappedFixedValue;   // mapped from the full case, see 0.orig/U
        offset          0;
        setAverage      off;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    "(walls|nozzle)"
    {
        type            kqRWallFunction;
        value           $internalField;
    }
}

