FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (30 0 0);

boundaryField
{
    // Exact mass flow + swirl W(r) taken from the full-scrubber gas solution
    // at x = 1.75 m (constant/inletSwirl, made by ./mapInlet). Axial velocity
    // uniform. T, k, omega are mapped (timeVaryingMappedFixedValue).
    inlet
    {
        type            swirlFlowRateInletVelocity;
        massFlowRate    constant 21.11;     // kg/s
        rhoInlet        1.106;
        origin          (0 0 0);
        axis            (1 0 0);
        radialVelocity  constant 0;
        #include        "$FOAM_CASE/constant/inletSwirl"
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    "(walls|nozzle)"
    {
        type            noSlip;
    }
}

