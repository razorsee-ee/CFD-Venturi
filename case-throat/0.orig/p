FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedMean;      // inside the swirling diffuser: only the mean is fixed
        meanValue       101325;         // (the real outlet further downstream is not modelled)
        value           $internalField;
    }
    "(walls|nozzle)"
    {
        type            zeroGradient;
    }
}

