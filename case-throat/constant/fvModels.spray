FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Copied to constant/fvModels by Allrun.spray: switches the oil spray on.
clouds
{
    type    clouds;
    libs    ("liblagrangianParcel.so");
    clouds  (cloud);    // main spray only
    // splash test: clouds (cloud splashCloud); and set massFlowRate 8.0 in
    // cloudProperties (splashCloud takes the other 10 %, see splashCloudProperties)
}

