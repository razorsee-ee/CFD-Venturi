FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      splashCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// SPLASH: 10 % of the oil (0.889 kg/s) as fine droplets leaving the rim of
// the deflector disk in all directions, also backwards (up to 150 deg from the
// flow direction). Shows where the wake behind the disk carries splashes.
// Separate cloud -> separate fate statistics and ./deposition --cloud splashCloud.
//
// Heavy oil spray, 32 t/h at 100 C: rho 1150 kg/m3 at 100 C (1.2 kg/l cold),
// 40 cSt at 100 C. Inert droplets: drag + heat exchange, no evaporation,
// no condensation, no breakup (sizes from correlations, see design/droplet_size.py).

type        thermoCloud;

solution
{
    coupled         true;
    transient       no;
    calcFrequency   10;         // cloud is re-tracked every 10 gas iterations
    maxTrackTime    1.0;        // s, > residence time in the scrubber
    maxCo           0.3;
    cellValueSourceCorrection off;

    sourceTerms
    {
        resetOnStartup  false;
        schemes
        {
            U               semiImplicit 0.5;   // relaxed: the spray is dense near the disk
            h               semiImplicit 0.5;
            radiation       semiImplicit 1;
        }
    }

    interpolationSchemes
    {
        rho             cell;
        U               cellPoint;
        mu              cell;
        T               cell;
        Cp              cell;
        kappa           cell;
        p               cell;
    }

    integrationSchemes
    {
        U               Euler;
        T               analytical;
    }
}

constantProperties
{
    rho0            1150;       // heavy oil at 100 C
    T0              373.15;
    Cp0             1950;
    epsilon0        1;
    f0              0.5;
}

subModels
{
    particleForces
    {
        sphereDrag;
        gravity;
    }

    injectionModels
    {
        diskRim
        {
            type            coneInjection;
            massFlowRate    0.889;          // kg/s = 10 % of 32 t/h
            parcelsPerSecond 3000;
            uniformParcelSize volume;

            position        (2.410 0 0);    // mid-thickness of the disk (2.406...2.414)
            direction       (1 0 0);
            injectionMethod disc;
            dInner          0.068;          // just outside the D65 rim
            dOuter          0.074;
            thetaInner      0;              // forward ...
            thetaOuter      150;            // ... radial ... and backwards

            flowType        constantVelocity;
            Umag            15;             // m/s, splashes are slower than the sheet

            sizeDistribution
            {
                type        RosinRammler;
                Q           3;
                min         5e-6;
                max         150e-6;
                d           45e-6;          // fine splash droplets, d32 ~ 30 um
                n           2.5;
            }
        }
    }

    dispersionModel stochasticDispersionRAS;

    patchInteractionModel localInteraction;

    heatTransferModel RanzMarshall;

    stochasticCollisionModel none;

    surfaceFilmModel none;

    radiation       off;

    // Every patch removes the droplet; the log then reports, per patch, how
    // much oil left through the outlet and how much deposited on the shell
    // ("walls") or on the lance/disk ("nozzle"). Wall film is not modelled.
    localInteractionCoeffs
    {
        patches
        (
            "(inlet|outlet|walls|nozzle)"
            {
                type    escape;
            }
        );
    }

    RanzMarshallCoeffs
    {
        BirdCorrection  false;
    }

    compositionModel singlePhaseMixture;

    singlePhaseMixtureCoeffs
    {
        phases
        (
            solid
            {
                oil     1;
            }
        );
    }
}

cloudFunctions
{
    // Oil mass hitting each wall face; in the steady cloud the field
    // splashCloud:massCollisionDensity on the walls is the deposition flux, kg/(m2 s)
    deposition
    {
        type            patchCollisionDensity;
        minSpeed        0;
    }

    outletParcels
    {
        type            patchPostProcessing;
        maxStoredParcels 20000;
        patches         (outlet walls nozzle);
    }

    tracks
    {
        type            particleTracks;
        trackInterval   5;
        maxSamples      200000;
        resetOnWrite    yes;
    }
}

