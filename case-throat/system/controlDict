FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          fluid;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         200;        // short gas-only start; Allrun.spray extends it

deltaT          1;

writeControl    timeStep;

writeInterval   100;        // gas stage ends at 600: must be a multiple

purgeWrite      2;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// function objects (residuals, pressure drop, ...) are in system/functions

// ************************************************************************* //
