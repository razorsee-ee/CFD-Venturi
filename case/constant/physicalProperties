FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Hypothetical pyrolysis gas as one pseudo-component, see design/design_basis.md
thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       67.4;
    }
    thermodynamics
    {
        Cp              2835;
        hf              0;
    }
    transport
    {
        mu              1.82e-05;
        Pr              1.04;
    }
}

// Droplet material for the oil spray (constant properties, heavy oil at ~100 C).
// Declared as a "solid" because the droplets neither evaporate nor condense.
liquids
{}

solids
{
    oil
    {
        defaultCoeffs   no;     // user-defined material, properties below
        oilCoeffs
        {
            rho             920;
            Cp              2100;
            kappa           0.13;
            hf              0;
            emissivity      1;
        }
    }
}

