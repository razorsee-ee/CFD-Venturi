// Hypothetical pyrolysis gas as one pseudo-component, see design/design_basis.md
thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       67.4;
    }
    thermodynamics
    {
        Cp              2835;
        hf              0;
    }
    transport
    {
        mu              1.82e-05;
        Pr              1.04;
    }
}

