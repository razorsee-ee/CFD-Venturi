FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.05;
    }

    "(U|h|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 1;
    transonic       no;
    consistent      yes;    // SIMPLEC: with SIMPLE the swirling case oscillated (inlet p +-50 kPa) on finer meshes

    residualControl
    {
        p               1e-5;
        U               1e-5;
        "(h|k|omega)"   1e-5;
    }
}

relaxationFactors
{
    fields
    {
        p               1;      // no p relaxation with SIMPLEC
        rho             0.05;   // essential: with 1 the steady compressible p-rho coupling diverges
    }
    equations
    {
        U               0.7;
        h               0.7;
        "(k|omega)"     0.7;
    }
}

