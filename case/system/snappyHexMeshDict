FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Cuts the spray lance, nozzle body and deflector disk out of the
// structured Venturi mesh made by blockMesh (mesh/make_blockmesh.py).

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh on;
snap            on;
addLayers       off;

geometry
{
    nozzle
    {
        type    closedTriSurfaceMesh;
        file    "nozzle.stl";
    }
}

castellatedMeshControls
{
    features
    (
        {
            file    "nozzle.eMesh";
            levels  ((0 2));
        }
    );

    refinementSurfaces
    {
        nozzle
        {
            level       (2 2);
            patchInfo
            {
                type    wall;
            }
        }
    }

    refinementRegions
    {
        nozzle
        {
            mode        distance;
            levels      ((0.01 2) (0.05 1));
        }
    }

    insidePoint     (0.5 0.1 0.1);
}

snapControls
{
    explicitFeatureSnap true;
    implicitFeatureSnap false;
}

addLayersControls
{
    layers
    {}
}

mergeTolerance  1e-6;

