FoamFile
{
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}

// Adaptive refinement around the oil surface: base cells 3.2 mm,
// maxRefinement 3 -> 0.4 mm (as the 2D case), 4 -> 0.2 mm (many more cells, raise maxCells)
topoChanger
{
    type            refiner;
    libs            ("libfvMeshTopoChangers.so");

    refineInterval  1;
    field           alpha.oil;
    lowerRefineLevel 0.001;
    upperRefineLevel 0.999;
    nBufferLayers   1;
    maxRefinement   3;
    maxCells        3000000;   // refinement stops here
    dumpLevel       false;
}

// Moves cells between processors as the refined zone grows (parallel runs only)
distributor
{
    type            distributor;
    libs            ("libfvMeshDistributors.so");
    redistributionInterval  20;
    maxImbalance    0.1;
}
