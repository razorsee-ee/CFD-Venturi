FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Background mesh: a quarter (90 deg) of the region around the nozzle axis (x),
// cubes of exactly 3.2 mm placed so that the lance tip (x = 0.082) and the disk
// faces (0.092, 0.100) lie on grid lines of the 0.4 mm level: snapping then does
// not move points on the cyclic planes near the axis (the solver's refinement
// checks that the cyclic faces match exactly). The two side planes (z = 0 and y = 0) are a rotational
// cyclic pair, so the swirl is kept: with the same cells in y and z the
// planes match after a 90 deg turn about x. snappyHexMesh cuts out the lance
// and the disk and refines around them; the solver refines around the oil.
convertToMeters 1;

vertices
(
    (-0.0504 0    0   )
    ( 0.2504 0    0   )
    ( 0.2504 0.1504 0   )
    (-0.0504 0.1504 0   )
    (-0.0504 0    0.1504)
    ( 0.2504 0    0.1504)
    ( 0.2504 0.1504 0.1504)
    (-0.0504 0.1504 0.1504)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (94 47 47) simpleGrading (1 1 1)
);

boundary
(
    gasInlet
    {
        type patch;
        faces ((0 4 7 3));
    }
    outlet
    {
        type patch;
        faces ((1 2 6 5));
    }
    outer
    {
        type wall;
        faces ((3 7 6 2) (4 5 6 7));
    }
    back            // z = 0
    {
        type cyclic;
        neighbourPatch front;
        transformType rotational;
        rotationAxis (1 0 0);
        rotationCentre (0 0 0);
        faces ((0 3 2 1));
    }
    front           // y = 0
    {
        type cyclic;
        neighbourPatch back;
        transformType rotational;
        rotationAxis (1 0 0);
        rotationCentre (0 0 0);
        faces ((0 1 5 4));
    }
);
