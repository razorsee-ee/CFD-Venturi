FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    "(gasInlet|oilInlet)"
    {
        type            calculated;
        value           uniform 0;
    }
    "(nozzle|disk|stem|strut)"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    "(outer|axis)"
    {
        type            calculated;
        value           uniform 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    "(front|back)"
    {
        type            cyclic;
    }
}
