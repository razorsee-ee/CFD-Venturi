FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// Steady gas field (no oil) used as the start of the VOF run: ../Allrun maps it
application     foamRun;

solver          incompressibleFluid;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         500;

deltaT          1;

writeControl    timeStep;

writeInterval   500;

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;
