FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh on;
snap            on;
addLayers       off;

// levels: 0 = 3.2 mm, 1 = 1.6, 2 = 0.8, 3 = 0.4 mm
geometry
{
    lance
    {
        type    closedTriSurfaceMesh;
        file    "lance.stl";
        regions
        {
            nozzle   { name nozzle; }
            oilInlet { name oilInlet; }
        }
    }
    disk
    {
        type    closedTriSurfaceMesh;
        file    "disk.stl";
    }
    stem
    {
        type    closedTriSurfaceMesh;
        file    "stem.stl";
    }
    strut
    {
        type    closedTriSurfaceMesh;
        file    "strut.stl";
    }
}

castellatedMeshControls
{
    features
    (
        { file "lance.eMesh"; levels ((0 3)); }
        { file "disk.eMesh";  levels ((0 3)); }
        { file "stem.eMesh";  levels ((0 3)); }
        { file "strut.eMesh"; levels ((0 3)); }
    );

    refinementSurfaces
    {
        lance
        {
            level       (1 1);
            regions
            {
                nozzle   { level (1 1); patchInfo { type wall; } }
                oilInlet { level (3 3); patchInfo { type patch; } }
            }
        }
        disk
        {
            level       (3 3);
            patchInfo   { type wall; }
        }
        stem
        {
            level       (3 3);
            patchInfo   { type wall; }
        }
        strut
        {
            level       (3 3);
            patchInfo   { type wall; }
        }
    }

    // no refinement zones (full circle: they would cost ~1.5 M cells); the solver
    // refines along the oil surface itself (constant/dynamicMeshDict)
    refinementRegions
    {
    }

    insidePoint     (0.05 0.08 0.07);
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      50;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    explicitFeatureSnap true;
    implicitFeatureSnap false;
}

addLayersControls
{
    layers
    {}
}

mergeTolerance  1e-6;
